import MsetsLower.Lower.Confidence.ReferenceGoodEvent
import MsetsLower.Lower.Confidence.Selection
import MsetsLower.Probability.ProbabilityComparison
import Mathlib.Analysis.Complex.ExponentialBounds

/-!
# Observable candidate selection under the reference law

The recovered statistic is bounded on every history generated by the
reference process.  Adding that probability-one support condition to the
observable good event lets the deterministic averaging and simultaneous
selection arguments operate directly on the common history event.
-/

namespace MsetsLower.Lower.Confidence

open MsetsLower Feedback MeasureTheory ProbabilityTheory Set
open scoped BigOperators ENNReal

noncomputable section

/-- Histories whose recovered reference noise belongs to `[-1,1]` in every
round.  This is a measurable, probability-one support of `P₀`. -/
def observableRecoveredNoiseSupport {n k : Nat} (hkn : k ≤ n) :
    (t : Nat) → Set (History n k t)
  | 0 => univ
  | t + 1 =>
      observableRecoveredNoiseSupport hkn t ×ˢ
        (recoveredConfidenceNoisePair hkn ⁻¹' Icc (-1 : Real) 1)

theorem measurableSet_observableRecoveredNoiseSupport
    {n k : Nat} (hkn : k ≤ n) :
    ∀ t, MeasurableSet (observableRecoveredNoiseSupport hkn t) := by
  intro t
  induction t with
  | zero => exact MeasurableSet.univ
  | succ t ih =>
      exact ih.prod <| measurableSet_Icc.preimage
        (measurable_recoveredConfidenceNoisePair hkn)

private theorem sourceUniformMeasure_Icc :
    sourceUniformMeasure (Icc (-1 : Real) 1) = 1 := by
  rw [← sourceUniformMeasure_apply_univ]
  apply measure_congr
  filter_upwards [ae_sourceUniformMeasure_mem_Icc] with z hz
  exact propext ⟨fun _ => trivial, fun _ => hz⟩

theorem confidenceReference_observableRecoveredNoiseSupport
    {n k : Nat} (P : Policy n k) (hkn : k ≤ n) :
    ∀ T, ((confidenceReferenceProcess P hkn).law T)
      (observableRecoveredNoiseSupport hkn T) = 1 := by
  intro T
  induction T with
  | zero => simp [observableRecoveredNoiseSupport]
  | succ t ih =>
      let μ := (confidenceReferenceProcess P hkn).law t
      let κ := confidenceReferenceRoundKernel P hkn t
      let S := observableRecoveredNoiseSupport hkn t
      let R := recoveredConfidenceNoisePair hkn ⁻¹' Icc (-1 : Real) 1
      letI : IsProbabilityMeasure μ :=
        (confidenceReferenceProcess P hkn).law_isProbabilityMeasure t
      letI : IsMarkovKernel κ :=
        confidenceReferenceRoundKernel_isMarkov P hkn t
      let hμsf : SFinite μ := by infer_instance
      letI : SFinite μ := hμsf
      let hκsf : IsSFiniteKernel κ := by infer_instance
      letI : IsSFiniteKernel κ := hκsf
      have hS : MeasurableSet S :=
        measurableSet_observableRecoveredNoiseSupport hkn t
      have hR : MeasurableSet R := measurableSet_Icc.preimage
        (measurable_recoveredConfidenceNoisePair hkn)
      have hround : ∀ h, κ h R = 1 := by
        intro h
        have hmap := confidenceReferenceRoundKernel_map_recoveredNoise
          P hkn t h
        have happly := congrArg
          (fun ν : Measure Real => ν (Icc (-1 : Real) 1)) hmap
        rw [Measure.map_apply (measurable_recoveredConfidenceNoisePair hkn)
          measurableSet_Icc] at happly
        exact happly.trans sourceUniformMeasure_Icc
      change (μ ⊗ₘ κ) (S ×ˢ R) = 1
      have hprod := @Measure.compProd_apply_prod
        (History n k t) (MSetAction n k × Real)
        (by infer_instance) (by infer_instance) μ κ hμsf hκsf S R hS hR
      rw [hprod]
      simp_rw [hround]
      simpa [μ, S] using ih

theorem confidenceReference_observableRecoveredNoiseSupport_real
    {n k : Nat} (P : Policy n k) (hkn : k ≤ n) (T : Nat) :
    ((confidenceReferenceProcess P hkn).law T).real
      (observableRecoveredNoiseSupport hkn T) = 1 := by
  rw [measureReal_def,
    confidenceReference_observableRecoveredNoiseSupport P hkn T]
  norm_num

/-- The analytic good event: the literal manuscript good event intersected
with a probability-one physical support of the recovered feedback. -/
def observableConfidenceReferenceGoodEvent
    {n k T : Nat} (hkn : k ≤ n) (B : Real) : Set (History n k T) :=
  observableConfidenceGoodEvent hkn B ∩
    observableRecoveredNoiseSupport hkn T

theorem measurableSet_observableConfidenceReferenceGoodEvent
    {n k T : Nat} (hkn : k ≤ n) (B : Real) :
    MeasurableSet (observableConfidenceReferenceGoodEvent (T := T) hkn B) :=
  (measurableSet_observableConfidenceGoodEvent hkn B).inter
    (measurableSet_observableRecoveredNoiseSupport hkn T)

theorem lower_confidence_reference_supported_good_event
    {n k T : Nat} (hk : 1 ≤ k) (hkn : k ≤ n)
    (P : Policy n k) (B delta : Real)
    (hdelta_pos : 0 < delta)
    (hdelta_small : delta ≤ 1 / (2 : Real) ^ 36)
    (hhorizon :
      4 * (n : Real) * (k : Real) ^ 2 *
          MsetsLower.Lower.confidenceLog delta ≤ (T : Real))
    (hpenaltyFailure :
      ((confidenceReferenceProcess P hkn).law T).real
          {h | B ≤ cumulativePenalty hkn T h} < delta) :
    (15 : Real) / 16 ≤
      ((confidenceReferenceProcess P hkn).law T).real
        (observableConfidenceReferenceGoodEvent hkn B) := by
  let G := observableConfidenceGoodEvent (T := T) hkn B
  let S := observableRecoveredNoiseSupport hkn T
  letI : IsProbabilityMeasure ((confidenceReferenceProcess P hkn).law T) :=
    (confidenceReferenceProcess P hkn).law_isProbabilityMeasure T
  have hG : MeasurableSet G :=
    measurableSet_observableConfidenceGoodEvent hkn B
  have hS : MeasurableSet S :=
    measurableSet_observableRecoveredNoiseSupport hkn T
  have hGraw : (15 : Real) / 16 ≤
      ((confidenceReferenceProcess P hkn).law T).real G := by
    simpa [G] using lower_confidence_reference_good_event
      hk hkn P B delta hdelta_pos hdelta_small hhorizon hpenaltyFailure
  have hSone : ((confidenceReferenceProcess P hkn).law T).real S = 1 := by
    simpa [S] using
      confidenceReference_observableRecoveredNoiseSupport_real P hkn T
  have hidentity := measureReal_union_add_inter
    (μ := (confidenceReferenceProcess P hkn).law T) (s := G) hS
  have hunion : ((confidenceReferenceProcess P hkn).law T).real (G ∪ S) ≤
      ((confidenceReferenceProcess P hkn).law T).real univ :=
    measureReal_mono (subset_univ _)
  have huniv : ((confidenceReferenceProcess P hkn).law T).real univ = 1 :=
    probReal_univ
  change (15 : Real) / 16 ≤
    ((confidenceReferenceProcess P hkn).law T).real (G ∩ S)
  nlinarith

/-- Sum of the common observable scores over all confidence candidates. -/
def totalObservableConfidenceScore
    {n k : Nat} (hkn : k ≤ n) (Delta B : Real)
    (t : Nat) (h : History n k t) : Real :=
  ∑ i ∈ confidenceCandidates n k hkn,
    observableConfidenceScore hkn Delta B i t h

theorem totalObservableConfidenceScore_zero
    {n k : Nat} (hkn : k ≤ n) (Delta B : Real)
    (h : History n k 0) :
    totalObservableConfidenceScore hkn Delta B 0 h = 0 := by
  simp [totalObservableConfidenceScore]

theorem totalObservableConfidenceScore_succ
    {n k t : Nat} (hkn : k ≤ n) (Delta B : Real)
    (h : History n k (t + 1)) :
    totalObservableConfidenceScore hkn Delta B (t + 1) h =
      totalObservableConfidenceScore hkn Delta B t h.1 +
        ((confidenceCandidates n k hkn).card : Real) *
          candidatePenalty hkn h.2.1 +
        Delta * shape (recoveredConfidenceNoise hkn h.2.1 h.2.2) *
          activeIndicator hkn B t h.1 *
          (((confidenceCandidates n k hkn).card : Real) -
            candidateCount hkn h.2.1) := by
  classical
  unfold totalObservableConfidenceScore
  simp_rw [observableConfidenceScore_succ]
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
  simp only [Finset.sum_const, nsmul_eq_mul]
  rw [← Finset.mul_sum, sum_missedIndicator]

/-- Observable version of the pathwise lower averaging bound, valid on the
probability-one physical support. -/
theorem totalObservableConfidenceScore_lower_of_cumulative_lt
    {n k : Nat} (hk : 1 ≤ k) (hkn : k ≤ n)
    (hN : 2 ≤ (confidenceCandidates n k hkn).card)
    (Delta : Real) (hDelta : 0 ≤ Delta)
    (hscale : Delta / (confidenceCandidates n k hkn).card ≤
      1 / (8 * (k : Real))) (B : Real) :
    ∀ (t : Nat) (h : History n k t),
      h ∈ observableRecoveredNoiseSupport hkn t →
      cumulativePenalty hkn t h < B →
      Delta * (((confidenceCandidates n k hkn).card : Real) / 2) *
          observableNoiseShapeSum hkn t h ≤
        totalObservableConfidenceScore hkn Delta B t h := by
  intro t
  induction t with
  | zero =>
      intro h hsupport hlt
      simp [observableNoiseShapeSum, totalObservableConfidenceScore]
  | succ t ih =>
      rintro ⟨hprev, ⟨A, y⟩⟩ hsupport hfinal
      have hpnonneg := (candidatePenalty_mem_Ico hk hkn A).1
      have hprevlt : cumulativePenalty hkn t hprev < B := by
        rw [cumulativePenalty_succ] at hfinal
        linarith
      have ihprev := ih hprev hsupport.1 hprevlt
      have hactive : activeIndicator hkn B t hprev = 1 := by
        simp [activeIndicator, hprevlt]
      have hz : recoveredConfidenceNoise hkn A y ∈ Icc (-1 : Real) 1 :=
        hsupport.2
      have hinc := total_score_increment_lower hk
        (candidateCount_pos hk hkn A) (candidateCount_le hkn A)
        (show (2 : Real) ≤ (confidenceCandidates n k hkn).card by
          exact_mod_cast hN)
        hDelta (shape_mem_Icc hz) hscale
      rw [observableNoiseShapeSum_succ,
        totalObservableConfidenceScore_succ, hactive, mul_one]
      calc
        Delta * (((confidenceCandidates n k hkn).card : Real) / 2) *
              (observableNoiseShapeSum hkn t hprev +
                shape (recoveredConfidenceNoise hkn A y)) =
            Delta * (((confidenceCandidates n k hkn).card : Real) / 2) *
                observableNoiseShapeSum hkn t hprev +
              Delta * (((confidenceCandidates n k hkn).card : Real) / 2) *
                shape (recoveredConfidenceNoise hkn A y) := by ring
        _ ≤ totalObservableConfidenceScore hkn Delta B t hprev +
              (((confidenceCandidates n k hkn).card : Real) *
                  (((candidateCount hkn A : Real) - 1) /
                    (8 * (k : Real))) +
                Delta * shape (recoveredConfidenceNoise hkn A y) *
                  (((confidenceCandidates n k hkn).card : Real) -
                    candidateCount hkn A)) := add_le_add ihprev hinc
        _ = totalObservableConfidenceScore hkn Delta B t hprev +
              ((confidenceCandidates n k hkn).card : Real) *
                candidatePenalty hkn A +
              Delta * shape (recoveredConfidenceNoise hkn A y) *
                (((confidenceCandidates n k hkn).card : Real) -
                  candidateCount hkn A) := by
            rw [candidatePenalty]
            ring

theorem lower_confidence_observable_average_score
    {n k T : Nat} (hk : 1 ≤ k) (hkn : k ≤ n)
    (hN : 2 ≤ (confidenceCandidates n k hkn).card)
    (Delta : Real) (hDelta : 0 ≤ Delta)
    (hscale : Delta / (confidenceCandidates n k hkn).card ≤
      1 / (8 * (k : Real))) (B : Real) (h : History n k T)
    (hsupport : h ∈ observableRecoveredNoiseSupport hkn T)
    (hpenalty : cumulativePenalty hkn T h < B)
    (hshape : (T : Real) / 2 ≤ observableNoiseShapeSum hkn T h) :
    Delta * T / 4 ≤
      totalObservableConfidenceScore hkn Delta B T h /
        (confidenceCandidates n k hkn).card := by
  have htotal := totalObservableConfidenceScore_lower_of_cumulative_lt
    hk hkn hN Delta hDelta hscale B T h hsupport hpenalty
  have hNpos : (0 : Real) < (confidenceCandidates n k hkn).card := by
    exact_mod_cast (lt_of_lt_of_le (by omega : 0 < 2) hN)
  have hscaled :
      Delta * (((confidenceCandidates n k hkn).card : Real) / 2) *
          (T / 2) ≤ totalObservableConfidenceScore hkn Delta B T h := by
    calc
      Delta * (((confidenceCandidates n k hkn).card : Real) / 2) * (T / 2) ≤
          Delta * (((confidenceCandidates n k hkn).card : Real) / 2) *
            observableNoiseShapeSum hkn T h := by gcongr
      _ ≤ totalObservableConfidenceScore hkn Delta B T h := htotal
  apply (le_div_iff₀ hNpos).2
  nlinarith

theorem observableNoiseShapeSum_le_time_of_support
    {n k : Nat} (hkn : k ≤ n) :
    ∀ (t : Nat) (h : History n k t),
      h ∈ observableRecoveredNoiseSupport hkn t →
      observableNoiseShapeSum hkn t h ≤ t := by
  intro t
  induction t with
  | zero => intro h hs; simp
  | succ t ih =>
      intro h hs
      rw [observableNoiseShapeSum_succ]
      have hshape :
          shape (recoveredConfidenceNoise hkn h.2.1 h.2.2) ≤ 1 := by
        simpa [recoveredConfidenceNoisePair] using (shape_mem_Icc hs.2).2
      have hprev := ih h.1 hs.1
      push_cast
      linarith

theorem observableConfidenceScore_le_cumulative_add_shape_of_support
    {n k : Nat} (hkn : k ≤ n) (Delta : Real) (hDelta : 0 ≤ Delta)
    (B : Real) (i : Fin n) :
    ∀ (t : Nat) (h : History n k t),
      h ∈ observableRecoveredNoiseSupport hkn t →
      observableConfidenceScore hkn Delta B i t h ≤
        cumulativePenalty hkn t h +
          Delta * observableNoiseShapeSum hkn t h := by
  intro t
  induction t with
  | zero =>
      intro h hs
      simp [observableConfidenceScore, cumulativePenalty,
        observableNoiseShapeSum]
  | succ t ih =>
      intro h hs
      rw [observableConfidenceScore_succ, cumulativePenalty_succ,
        observableNoiseShapeSum_succ]
      have hshape := shape_mem_Icc hs.2
      have hactive := activeIndicator_mem_Icc hkn B t h.1
      have hmissed := missedIndicator_mem_Icc i h.2.1
      have hbase :
          0 ≤ Delta * shape (recoveredConfidenceNoise hkn h.2.1 h.2.2) :=
        mul_nonneg hDelta hshape.1
      have hbonus :
          Delta * shape (recoveredConfidenceNoise hkn h.2.1 h.2.2) *
                activeIndicator hkn B t h.1 * missedIndicator i h.2.1 ≤
            Delta * shape (recoveredConfidenceNoise hkn h.2.1 h.2.2) := by
        calc
          Delta * shape (recoveredConfidenceNoise hkn h.2.1 h.2.2) *
                activeIndicator hkn B t h.1 * missedIndicator i h.2.1 ≤
              Delta * shape (recoveredConfidenceNoise hkn h.2.1 h.2.2) *
                activeIndicator hkn B t h.1 := by
            simpa using mul_le_mul_of_nonneg_left hmissed.2
              (mul_nonneg hbase hactive.1)
          _ ≤ Delta * shape
              (recoveredConfidenceNoise hkn h.2.1 h.2.2) := by
            simpa using mul_le_mul_of_nonneg_left hactive.2 hbase
      linarith [ih h.1 hs.1]

theorem observableConfidenceScore_le_seventeen_sixteenths
    {n k T : Nat} (hkn : k ≤ n)
    (Delta : Real) (hDelta : 0 ≤ Delta) (B : Real)
    (hB : B = Delta * T / 16) (i : Fin n) (h : History n k T)
    (hgood : h ∈ observableConfidenceReferenceGoodEvent (T := T) hkn B) :
    observableConfidenceScore hkn Delta B i T h ≤
      (17 : Real) * (Delta * T) / 16 := by
  have hscore := observableConfidenceScore_le_cumulative_add_shape_of_support
    hkn Delta hDelta B i T h hgood.2
  have hshape := observableNoiseShapeSum_le_time_of_support
    hkn T h hgood.2
  have hshapeScaled :
      Delta * observableNoiseShapeSum hkn T h ≤ Delta * T :=
    mul_le_mul_of_nonneg_left hshape hDelta
  have hpenalty : cumulativePenalty hkn T h < B := hgood.1.1
  calc
    observableConfidenceScore hkn Delta B i T h ≤
        cumulativePenalty hkn T h +
          Delta * observableNoiseShapeSum hkn T h := hscore
    _ ≤ cumulativePenalty hkn T h + Delta * T := by linarith
    _ ≤ B + Delta * T := by linarith
    _ = (17 : Real) * (Delta * T) / 16 := by rw [hB]; ring

/-- Observable version of `eq:lower-confidence-average-event` under the
genuine reference law. -/
theorem lower_confidence_reference_average_event
    {n k T : Nat} (hk : 1 ≤ k) (hkn : k ≤ n)
    (hN : 2 ≤ (confidenceCandidates n k hkn).card)
    (Delta : Real) (hDelta : 0 < Delta)
    (hscale : Delta / (confidenceCandidates n k hkn).card ≤
      1 / (8 * (k : Real))) (B : Real) (hB : B = Delta * T / 16)
    (hT : 1 ≤ T) (P : Policy n k)
    (hGprob : (15 : Real) / 16 ≤
      ((confidenceReferenceProcess P hkn).law T).real
        (observableConfidenceReferenceGoodEvent hkn B)) :
    (1 : Real) / 8 ≤
      (∑ i ∈ confidenceCandidates n k hkn,
        ((confidenceReferenceProcess P hkn).law T).real
          (observableConfidenceScoreEvent hkn Delta B i)) /
        (confidenceCandidates n k hkn).card := by
  let candidates := confidenceCandidates n k hkn
  let events : Fin n → Set (History n k T) :=
    fun i => observableConfidenceScoreEvent hkn Delta B i
  let G := observableConfidenceReferenceGoodEvent (T := T) hkn B
  letI : IsProbabilityMeasure ((confidenceReferenceProcess P hkn).law T) :=
    (confidenceReferenceProcess P hkn).law_isProbabilityMeasure T
  have hM : 0 < Delta * T := mul_pos hDelta (by exact_mod_cast hT)
  have hcandidates : candidates.Nonempty := by
    exact Finset.card_pos.mp (lt_of_lt_of_le (by omega : 0 < 2) hN)
  have hE : ∀ i ∈ candidates, MeasurableSet (events i) := by
    intro i hi
    exact measurableSet_observableConfidenceScoreEvent hkn Delta B i
  apply Probability.average_event_probability_ge_one_eighth
    ((confidenceReferenceProcess P hkn).law T) candidates events hE G
      (measurableSet_observableConfidenceReferenceGoodEvent hkn B)
      (by simpa [G] using hGprob)
  intro h hhgood
  change (2 : Real) / 15 ≤ Probability.eventFraction candidates
    (fun i => {x | Delta * T / 8 ≤
      observableConfidenceScore hkn Delta B i T x}) h
  rw [Probability.eventFraction_eq_highScoreFraction]
  apply Probability.highScoreFraction_ge_two_fifteenths
    candidates hcandidates
      (fun i => observableConfidenceScore hkn Delta B i T h) hM
  · simpa [candidates, totalObservableConfidenceScore] using
      (lower_confidence_observable_average_score hk hkn hN Delta hDelta.le
        hscale B h hhgood.2 hhgood.1.1 hhgood.1.2)
  · intro i hi
    exact observableConfidenceScore_le_seventeen_sixteenths hkn Delta
      hDelta.le B hB i h hhgood

/-- Simultaneous candidate selection for the common observable score event. -/
theorem lower_confidence_selected_observable_candidate
    {n k T : Nat} (hk : 1 ≤ k) (hkn : k ≤ n)
    (hN : 2 ≤ (confidenceCandidates n k hkn).card)
    (Delta : Real) {B : Real} (hB : 0 ≤ B)
    (μ : Measure (History n k T)) [IsProbabilityMeasure μ]
    (hprob_average : (1 : Real) / 8 ≤
      (∑ i ∈ confidenceCandidates n k hkn,
        μ.real (observableConfidenceScoreEvent hkn Delta B i)) /
          (confidenceCandidates n k hkn).card) :
    ∃ i ∈ confidenceCandidates n k hkn,
      (1 : Real) / 16 ≤
          μ.real (observableConfidenceScoreEvent hkn Delta B i) ∧
      (∫ h, activeSelectedCount hkn B i T h ∂μ) ≤
        (16 / (confidenceCandidates n k hkn).card : Real) *
          ((T : Real) + 8 * (k : Real) * B + (k : Real)) := by
  let candidates := confidenceCandidates n k hkn
  let events : Fin n → Set (History n k T) :=
    fun i => observableConfidenceScoreEvent hkn Delta B i
  let pulls : Fin n → History n k T → Real :=
    fun i => activeSelectedCount hkn B i T
  let budget : Real := (T : Real) + 8 * (k : Real) * B + (k : Real)
  have hcandidates : candidates.Nonempty := by
    exact Finset.card_pos.mp (lt_of_lt_of_le (by omega : 0 < 2) hN)
  have hNpos : (0 : Real) < candidates.card := by
    exact_mod_cast hcandidates.card_pos
  have hprob_sum : (candidates.card : Real) * ((1 : Real) / 8) ≤
      ∑ i ∈ candidates, μ.real (events i) := by
    have hscaled := (le_div_iff₀ hNpos).mp
      (show (1 : Real) / 8 ≤
          (∑ i ∈ candidates, μ.real (events i)) / candidates.card by
        simpa [candidates, events] using hprob_average)
    simpa [mul_comm] using hscaled
  have hpulls_sum :
      ∑ i ∈ candidates, ∫ h, pulls i h ∂μ ≤
        (candidates.card : Real) * (budget / candidates.card) := by
    have hraw := sum_expected_activeSelectedCount_le hk hkn hB μ
    have hbudget : budget =
        (T : Real) + 8 * (k : Real) * B + (k : Real) := rfl
    rw [show (candidates.card : Real) * (budget / candidates.card) = budget by
      field_simp]
    simpa [candidates, pulls, hbudget] using hraw
  obtain ⟨i, hi, hiprob, hipulls⟩ :=
    Probability.select_good_index_finset μ candidates hcandidates events pulls
      (fun i hi => measurableSet_observableConfidenceScoreEvent hkn Delta B i)
      (fun i hi => ae_of_all μ fun h =>
        activeSelectedCount_nonneg hkn B i T h)
      (p := (1 : Real) / 8) (w := budget / candidates.card)
      (by norm_num) (by norm_num) hprob_sum hpulls_sum
  refine ⟨i, ?_, ?_, ?_⟩
  · simpa [candidates] using hi
  · norm_num at hiprob ⊢
    exact hiprob
  · dsimp [candidates, pulls, budget] at hipulls ⊢
    norm_num [div_eq_mul_inv] at hipulls ⊢
    ring_nf at hipulls ⊢
    exact hipulls

/-- `eq:lower-confidence-selected-candidate` for the actual reference
process and the common observable event. -/
theorem lower_confidence_reference_selected_candidate
    {n k T : Nat} (hk : 1 ≤ k) (hkn : k ≤ n)
    (hN : 2 ≤ (confidenceCandidates n k hkn).card)
    (P : Policy n k) (Delta : Real) {B : Real} (hB : 0 ≤ B)
    (hprob_average : (1 : Real) / 8 ≤
      (∑ i ∈ confidenceCandidates n k hkn,
        ((confidenceReferenceProcess P hkn).law T).real
          (observableConfidenceScoreEvent hkn Delta B i)) /
          (confidenceCandidates n k hkn).card) :
    ∃ i ∈ confidenceCandidates n k hkn,
      (1 : Real) / 16 ≤
        ((confidenceReferenceProcess P hkn).law T).real
          (observableConfidenceScoreEvent hkn Delta B i) ∧
      (∫ h, activeSelectedCount hkn B i T h
          ∂(confidenceReferenceProcess P hkn).law T) ≤
        (16 / (confidenceCandidates n k hkn).card : Real) *
          ((T : Real) + 8 * (k : Real) * B + (k : Real)) := by
  letI : IsProbabilityMeasure ((confidenceReferenceProcess P hkn).law T) :=
    (confidenceReferenceProcess P hkn).law_isProbabilityMeasure T
  exact lower_confidence_selected_observable_candidate
    hk hkn hN Delta hB ((confidenceReferenceProcess P hkn).law T)
      hprob_average

theorem confidence_delta_small_le_comparison_threshold
    {delta : Real} (hdelta_small : delta ≤ 1 / (2 : Real) ^ 36) :
    delta ≤ (2 : Real) ^ (-2 / ((1 : Real) / 16)) := by
  calc
    delta ≤ 1 / (2 : Real) ^ 36 := hdelta_small
    _ ≤ (2 : Real) ^ (-2 / ((1 : Real) / 16)) := by
      rw [show (-2 / ((1 : Real) / 16)) = (-32 : Real) by norm_num,
        show (-32 : Real) = -(32 : Nat) by norm_num,
        Real.rpow_neg_natCast]
      norm_num

theorem confidenceLog_lower_of_delta_small
    {delta : Real} (hdelta_pos : 0 < delta)
    (hdelta_small : delta ≤ 1 / (2 : Real) ^ 36) :
    (36 : Real) * Real.log 2 ≤
      MsetsLower.Lower.confidenceLog delta := by
  have hpow_pos : 0 < (2 : Real) ^ 36 := by positivity
  have hinv_pos : 0 < (1 : Real) / delta := div_pos zero_lt_one hdelta_pos
  have hpow_le_inv : (2 : Real) ^ 36 ≤ 1 / delta := by
    apply (le_div_iff₀ hdelta_pos).2
    calc
      (2 : Real) ^ 36 * delta ≤
          (2 : Real) ^ 36 * (1 / (2 : Real) ^ 36) :=
        mul_le_mul_of_nonneg_left hdelta_small hpow_pos.le
      _ = 1 := by field_simp
  have hlogmono :
      Real.log ((2 : Real) ^ 36) ≤ Real.log (1 / delta) :=
    Real.strictMonoOn_log.monotoneOn hpow_pos hinv_pos hpow_le_inv
  rw [Real.log_pow] at hlogmono
  simpa [MsetsLower.Lower.confidenceLog] using hlogmono

/-- All analytic side conditions consumed by the stochastic confidence
pipeline, discharged from the literal proposition hypotheses and parameter
definitions. -/
theorem confidence_stochastic_parameter_package
    {n k T : Nat} (hk : 1 ≤ k) (hkn : k ≤ n) (hhalf : k ≤ n / 2)
    {delta : Real} (hdelta_pos : 0 < delta)
    (hdelta_small : delta ≤ 1 / (2 : Real) ^ 36)
    (hhorizon :
      4 * (n : Real) * (k : Real) ^ 2 *
          MsetsLower.Lower.confidenceLog delta ≤ (T : Real)) :
    let N : Real := (confidenceCandidates n k hkn).card
    let L : Real := MsetsLower.Lower.confidenceLog delta
    let Delta : Real := confidenceDelta N L T
    let B : Real := confidenceBudget N L T
    2 ≤ (confidenceCandidates n k hkn).card ∧
      0 < Delta ∧
      Delta / (confidenceCandidates n k hkn).card ≤
        1 / (8 * (k : Real)) ∧
      B = Delta * T / 16 ∧
      0 ≤ B ∧
      1 ≤ T ∧
      |4 * Delta| ≤ 1 / 16 ∧
      Delta = confidenceDelta
        ((confidenceCandidates n k hkn).card : Real) L T ∧
      (k : Real) * Delta / 2 ≤ 1 / (2 : Real) ^ 14 ∧
      (k : Real) / T ≤ 1 / 8 := by
  dsimp only
  let N : Real := (confidenceCandidates n k hkn).card
  let L : Real := MsetsLower.Lower.confidenceLog delta
  let Delta : Real := confidenceDelta N L T
  let B : Real := confidenceBudget N L T
  have hNnat : 2 ≤ (confidenceCandidates n k hkn).card := by
    rw [card_confidenceCandidates hk hkn]
    omega
  have hNpos : 0 < N := by
    dsimp [N]
    exact_mod_cast (lt_of_lt_of_le (by omega : 0 < 2) hNnat)
  have hNtwo : (2 : Real) ≤ N := by
    dsimp [N]
    exact_mod_cast hNnat
  have hNleNat : (confidenceCandidates n k hkn).card ≤ n := by
    rw [card_confidenceCandidates hk hkn]
    omega
  have hNle : N ≤ (n : Real) := by
    dsimp [N]
    exact_mod_cast hNleNat
  have hkreal : (1 : Real) ≤ k := by exact_mod_cast hk
  have hkpos : (0 : Real) < k := zero_lt_one.trans_le hkreal
  have hn2kNat : 2 * k ≤ n := by omega
  have hn2k : (2 : Real) * k ≤ n := by exact_mod_cast hn2kNat
  have hLlower := confidenceLog_lower_of_delta_small hdelta_pos hdelta_small
  have hLpos : 0 < L := by
    dsimp [L]
    nlinarith [Real.log_two_gt_d9]
  have hLone : (1 : Real) ≤ L := by
    dsimp [L]
    nlinarith [Real.log_two_gt_d9]
  have h8kT : 8 * (k : Real) ≤ (T : Real) := by
    calc
      8 * (k : Real) =
          4 * ((2 : Real) * k) * (1 : Real) ^ 2 * 1 := by ring
      _ ≤ 4 * (n : Real) * (k : Real) ^ 2 * L := by gcongr
      _ ≤ (T : Real) := by simpa [L] using hhorizon
  have hTpos : 0 < (T : Real) :=
    (mul_pos (by norm_num) hkpos).trans_le h8kT
  have hTnat : 1 ≤ T := by exact_mod_cast hTpos
  have hLnonneg : 0 ≤ L := hLpos.le
  have hsmallRaw := confidence_delta_small hkreal hNle hTpos hLnonneg
    (by simpa [L] using hhorizon)
  have hsmall :
      (k : Real) * Delta ≤ confidenceConstant / 2 ∧
        Delta ≤ 1 / (2 : Real) ^ 13 := by
    simpa [Delta, N] using hsmallRaw
  have hDeltaPos : 0 < Delta := by
    have hinside : 0 < N * L / (T : Real) := by positivity
    dsimp [Delta, confidenceDelta]
    exact mul_pos confidenceConstant_pos (Real.sqrt_pos.2 hinside)
  have hscale :
      Delta / (confidenceCandidates n k hkn).card ≤
        1 / (8 * (k : Real)) := by
    have h8kpos : 0 < 8 * (k : Real) := by positivity
    have htarget : Delta ≤ N / (8 * (k : Real)) := by
      apply (le_div_iff₀ h8kpos).2
      have hkd := hsmall.1
      norm_num [confidenceConstant] at hkd
      nlinarith
    have hNcast : ((confidenceCandidates n k hkn).card : Real) = N := by rfl
    rw [hNcast]
    apply (div_le_iff₀ hNpos).2
    calc
      Delta ≤ N / (8 * (k : Real)) := htarget
      _ = (1 / (8 * (k : Real))) * N := by ring
  have hBeq : B = Delta * T / 16 := by
    rfl
  have hBnonneg : 0 ≤ B := by rw [hBeq]; positivity
  have hfeedback : |4 * Delta| ≤ 1 / 16 := by
    rw [abs_of_nonneg (mul_nonneg (by norm_num) hDeltaPos.le)]
    nlinarith [hsmall.2]
  have hkDelta :
      (k : Real) * Delta / 2 ≤ 1 / (2 : Real) ^ 14 := by
    have hkd := hsmall.1
    norm_num [confidenceConstant] at hkd ⊢
    linarith
  have hkT : (k : Real) / T ≤ 1 / 8 := by
    apply (div_le_iff₀ hTpos).2
    linarith
  exact ⟨hNnat, hDeltaPos, hscale, hBeq, hBnonneg, hTnat,
    hfeedback, rfl, hkDelta, hkT⟩

theorem confidenceDelta_mul_time_div_eight
    {N L T : Real} (hN : 0 ≤ N) (hL : 0 ≤ L) (hT : 0 < T) :
    confidenceDelta N L T * T / 8 =
      confidenceConstant / 8 * Real.sqrt (N * T * L) := by
  have hNL : 0 ≤ N * L := mul_nonneg hN hL
  have hsqrtTpos : 0 < Real.sqrt T := Real.sqrt_pos.2 hT
  have hquot : T / Real.sqrt T = Real.sqrt T := by
    rw [div_eq_iff hsqrtTpos.ne']
    nlinarith [Real.sq_sqrt hT.le]
  rw [confidenceDelta]
  calc
    confidenceConstant * Real.sqrt (N * L / T) * T / 8 =
        confidenceConstant / 8 *
          (Real.sqrt (N * L) / Real.sqrt T * T) := by
      rw [Real.sqrt_div hNL]
      ring
    _ = confidenceConstant / 8 *
          (Real.sqrt (N * L) * Real.sqrt T) := by
      rw [show Real.sqrt (N * L) / Real.sqrt T * T =
          Real.sqrt (N * L) * (T / Real.sqrt T) by ring, hquot]
    _ = confidenceConstant / 8 * Real.sqrt ((N * L) * T) := by
      rw [Real.sqrt_mul hNL]
    _ = confidenceConstant / 8 * Real.sqrt (N * T * L) := by ring_nf

theorem confidence_score_threshold_dominates_target
    {n N T L : Real} (hn : 0 ≤ n) (hN : n / 2 ≤ N)
    (hT : 0 < T) (hL : 0 ≤ L) :
    (1 / (2 : Real) ^ 17) * Real.sqrt (n * T * L) ≤
      confidenceDelta N L T * T / 8 := by
  have hsqrt_nonneg : 0 ≤ Real.sqrt (n * T * L) := Real.sqrt_nonneg _
  have hweaken :
      (1 / (2 : Real) ^ 17) * Real.sqrt (n * T * L) ≤
        (1 / (2 : Real) ^ 16) * Real.sqrt (n * T * L) := by
    exact mul_le_mul_of_nonneg_right (by norm_num) hsqrt_nonneg
  have hstrong := confidence_score_dominates_target
    hn hT.le hL hN
  have hNnonneg : 0 ≤ N := by nlinarith
  rw [confidenceDelta_mul_time_div_eight hNnonneg hL hT]
  exact hweaken.trans hstrong

/-- The common observable event transfers from `P₀` to `Pᵢ` using the
sequential KL theorem with the manuscript's literal constants. -/
theorem lower_confidence_observable_event_probability_comparison
    {n k T : Nat} (P : Policy n k) (hkn : k ≤ n)
    (hN : 2 ≤ (confidenceCandidates n k hkn).card)
    {Delta : Real} (hfeedback : |4 * Delta| ≤ 1 / 16)
    (B : Real) (i : Fin n) {delta : Real}
    (hdelta_pos : 0 < delta)
    (hdelta_small : delta ≤ 1 / (2 : Real) ^ 36)
    (hT : 0 < (T : Real))
    (hDelta : Delta = confidenceDelta
      ((confidenceCandidates n k hkn).card : Real)
      (MsetsLower.Lower.confidenceLog delta) T)
    (hB : B = Delta * T / 16)
    (hPulls :
      (∫ h, activeSelectedCount hkn B i T h
        ∂(confidenceReferenceProcess P hkn).law T) ≤
        (16 / (confidenceCandidates n k hkn).card : Real) *
          ((T : Real) + 8 * (k : Real) * B + (k : Real)))
    (hkDelta : (k : Real) * Delta / 2 ≤ 1 / (2 : Real) ^ 14)
    (hkT : (k : Real) / T ≤ 1 / 8)
    (hreference : (1 : Real) / 16 ≤
      ((confidenceReferenceProcess P hkn).law T).real
        (observableConfidenceScoreEvent hkn Delta B i)) :
    delta ≤
      ((confidencePlantedProcess P hkn Delta hfeedback B i).law T).real
        (observableConfidenceScoreEvent hkn Delta B i) := by
  let P0 := (confidenceReferenceProcess P hkn).law T
  let Pi := (confidencePlantedProcess P hkn Delta hfeedback B i).law T
  let E := observableConfidenceScoreEvent (T := T) hkn Delta B i
  let L := MsetsLower.Lower.confidenceLog delta
  letI hP0prob : IsProbabilityMeasure P0 :=
    (confidenceReferenceProcess P hkn).law_isProbabilityMeasure T
  letI hPiprob : IsProbabilityMeasure Pi :=
    (confidencePlantedProcess P hkn Delta hfeedback B i).law_isProbabilityMeasure T
  have hNpos : (0 : Real) < (confidenceCandidates n k hkn).card := by
    exact_mod_cast (lt_of_lt_of_le (by omega : 0 < 2) hN)
  have hdelta_one : delta ≤ 1 := hdelta_small.trans (by norm_num)
  have hL : 0 ≤ L := by
    dsimp [L]
    exact MsetsLower.Lower.confidenceLog_nonneg hdelta_pos hdelta_one
  have hKLraw := lower_confidence_kl P hkn hfeedback B i
    hNpos hL hT hDelta hB hPulls hkDelta hkT
  have hcoefficient :
      (1 / (2 : Real) ^ 8) ≤ ((1 : Real) / 16) / 4 := by norm_num
  have hrealKL :
      (1 / (2 : Real) ^ 8) * L ≤
        ((1 : Real) / 16) / 4 * Real.log (1 / delta) := by
    have hmul := mul_le_mul_of_nonneg_right hcoefficient hL
    simpa [L, MsetsLower.Lower.confidenceLog] using hmul
  have hKL : InformationTheory.klDiv P0 Pi ≤
      ENNReal.ofReal
        (((1 : Real) / 16) / 4 * Real.log (1 / delta)) := by
    exact hKLraw.trans (ENNReal.ofReal_le_ofReal hrealKL)
  exact @MsetsLower.Probability.probability_comparison
    (History n k T) (by infer_instance) P0 Pi hP0prob hPiprob E
    (measurableSet_observableConfidenceScoreEvent hkn Delta B i)
    ((1 : Real) / 16) delta (by norm_num) (by norm_num)
    (by simpa [P0, E] using hreference)
    (by simpa [P0, Pi] using hKL) hdelta_pos
    (confidence_delta_small_le_comparison_threshold hdelta_small)

/-- Stochastic second branch of `prop:lower-confidence`, immediately before
fixing the source table.  The conclusion is a single common measurable event
under the planted history law. -/
theorem lower_confidence_stochastic_second_branch
    {n k T : Nat} (hk : 1 ≤ k) (hkn : k ≤ n)
    (hN : 2 ≤ (confidenceCandidates n k hkn).card)
    (P : Policy n k) {Delta : Real} (hDelta_pos : 0 < Delta)
    (hscale : Delta / (confidenceCandidates n k hkn).card ≤
      1 / (8 * (k : Real)))
    {B : Real} (hB : B = Delta * T / 16) (hB_nonneg : 0 ≤ B)
    (hT : 1 ≤ T) {delta : Real}
    (hdelta_pos : 0 < delta)
    (hdelta_small : delta ≤ 1 / (2 : Real) ^ 36)
    (hhorizon :
      4 * (n : Real) * (k : Real) ^ 2 *
          MsetsLower.Lower.confidenceLog delta ≤ (T : Real))
    (hpenaltyFailure :
      ((confidenceReferenceProcess P hkn).law T).real
          {h | B ≤ cumulativePenalty hkn T h} < delta)
    (hfeedback : |4 * Delta| ≤ 1 / 16)
    (hDelta : Delta = confidenceDelta
      ((confidenceCandidates n k hkn).card : Real)
      (MsetsLower.Lower.confidenceLog delta) T)
    (hkDelta : (k : Real) * Delta / 2 ≤ 1 / (2 : Real) ^ 14)
    (hkT : (k : Real) / T ≤ 1 / 8) :
    ∃ i ∈ confidenceCandidates n k hkn,
      delta ≤
        ((confidencePlantedProcess P hkn Delta hfeedback B i).law T).real
          (observableConfidenceScoreEvent hkn Delta B i) := by
  have hG := lower_confidence_reference_supported_good_event
    hk hkn P B delta hdelta_pos hdelta_small hhorizon hpenaltyFailure
  have haverage := lower_confidence_reference_average_event
    hk hkn hN Delta hDelta_pos hscale B hB hT P hG
  obtain ⟨i, hi, hreference, hpulls⟩ :=
    lower_confidence_reference_selected_candidate
      hk hkn hN P Delta hB_nonneg haverage
  refine ⟨i, hi, ?_⟩
  exact lower_confidence_observable_event_probability_comparison
    P hkn hN hfeedback B i hdelta_pos hdelta_small
      (by exact_mod_cast hT) hDelta hB hpulls hkDelta hkT hreference

/-- Literal-parameter stochastic capstone for `prop:lower-confidence` in the
small-penalty branch.  Only fixing the source table remains after this
statement. -/
theorem lower_confidence_stochastic_before_fixing
    {n k T : Nat} (hk : 1 ≤ k) (hhalf : k ≤ n / 2)
    (P : Policy n k) {delta : Real}
    (hdelta_pos : 0 < delta)
    (hdelta_small : delta ≤ 1 / (2 : Real) ^ 36)
    (hhorizon :
      4 * (n : Real) * (k : Real) ^ 2 *
          MsetsLower.Lower.confidenceLog delta ≤ (T : Real))
    (hpenaltyFailure :
      let hkn : k ≤ n := hhalf.trans (Nat.div_le_self n 2)
      let N : Real := (confidenceCandidates n k hkn).card
      let L : Real := MsetsLower.Lower.confidenceLog delta
      let B : Real := confidenceBudget N L T
      ((confidenceReferenceProcess P hkn).law T).real
        {h | B ≤ cumulativePenalty hkn T h} < delta) :
    let hkn : k ≤ n := hhalf.trans (Nat.div_le_self n 2)
    let N : Real := (confidenceCandidates n k hkn).card
    let L : Real := MsetsLower.Lower.confidenceLog delta
    let Delta : Real := confidenceDelta N L T
    let B : Real := confidenceBudget N L T
    ∃ hfeedback : |4 * Delta| ≤ 1 / 16,
      ∃ i ∈ confidenceCandidates n k hkn,
        delta ≤
          ((confidencePlantedProcess P hkn Delta hfeedback B i).law T).real
            (observableConfidenceScoreEvent hkn Delta B i) ∧
        (1 / (2 : Real) ^ 17) * Real.sqrt ((n : Real) * T * L) ≤
          Delta * T / 8 := by
  let hkn : k ≤ n := hhalf.trans (Nat.div_le_self n 2)
  let N : Real := (confidenceCandidates n k hkn).card
  let L : Real := MsetsLower.Lower.confidenceLog delta
  let Delta : Real := confidenceDelta N L T
  let B : Real := confidenceBudget N L T
  have hparams := confidence_stochastic_parameter_package
    hk hkn hhalf hdelta_pos hdelta_small hhorizon
  rcases hparams with
    ⟨hN, hDelta_pos, hscale, hB, hB_nonneg, hT, hfeedback,
      hDelta, hkDelta, hkT⟩
  have hpenalty :
      ((confidenceReferenceProcess P hkn).law T).real
        {h | B ≤ cumulativePenalty hkn T h} < delta := by
    simpa [hkn, N, L, Delta, B] using hpenaltyFailure
  obtain ⟨i, hi, hprob⟩ := lower_confidence_stochastic_second_branch
    hk hkn hN P hDelta_pos hscale hB hB_nonneg hT
      hdelta_pos hdelta_small hhorizon hpenalty hfeedback hDelta hkDelta hkT
  have hn2kNat : 2 * k ≤ n := by omega
  have hn2k : (2 : Real) * k ≤ n := by exact_mod_cast hn2kNat
  have hNformula : N = (n : Real) - k + 1 := by
    dsimp [N]
    rw [card_confidenceCandidates hk hkn, Nat.cast_add,
      Nat.cast_sub hkn, Nat.cast_one]
  have hNhalf : (n : Real) / 2 ≤ N := by
    rw [hNformula]
    nlinarith
  have hdelta_one : delta ≤ 1 := hdelta_small.trans (by norm_num)
  have hLnonneg : 0 ≤ L := by
    dsimp [L]
    exact MsetsLower.Lower.confidenceLog_nonneg hdelta_pos hdelta_one
  have hthreshold := confidence_score_threshold_dominates_target
    (n := (n : Real)) (N := N) (T := (T : Real)) (L := L)
    (by positivity) hNhalf (by exact_mod_cast hT) hLnonneg
  exact ⟨hfeedback, i, hi, hprob, by simpa [Delta] using hthreshold⟩

end

