import MsetsLower.Probability.KernelFixing
import MsetsLower.Probability.MeanToTail
import MsetsLower.Lower.Statement
import MsetsPaper.Lower.ComplementSeed

/-!
# Foundations of the manuscript lower bound

This file connects `lem:lower-fixing-table` (L10), `lem:lower-complement`
(L11), and `lem:lower-mean-to-probability` (L13) to the preserved,
measure-theoretic protocol library. The complement statement concerns actual
run laws and deterministic non-anticipating loss processes, not abstract
numerical lower-bound certificates.

The auxiliary deficit corollaries deliberately do not assume a nonnegative
deficit. They expose the expectation, upper bound, and pathwise comparison
that the sparse and dense constructions must still supply.
-/

namespace MsetsPaper.Lower

open MsetsLower MsetsLower.Lower MeasureTheory ProbabilityTheory
open scoped ENNReal ProbabilityTheory

noncomputable section

/-- L10, for independent adversary and learner seeds. The random variable may
be the regret generated by their measurable interaction. No sign restriction
on the threshold is needed for the averaging argument. -/
theorem exists_fixed_adversary_seed
    {Ξ R : Type*} [MeasurableSpace Ξ] [MeasurableSpace R]
    (μ : Measure Ξ) (ν : Measure R)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (regret : Ξ × R → ℝ) (hregret : Measurable regret)
    {b p : ℝ} (hp : p ≤ (μ.prod ν).real {ω | b ≤ regret ω}) :
    ∃ ξ : Ξ, p ≤ ν.real {r | b ≤ regret (ξ, r)} := by
  have hE : MeasurableSet {ω | b ≤ regret ω} :=
    measurableSet_le measurable_const hregret
  have hpENN : ENNReal.ofReal p ≤ (μ.prod ν) {ω | b ≤ regret ω} := by
    apply (ENNReal.ofReal_le_iff_le_toReal (measure_ne_top _ _)).2
    simpa [measureReal_def] using hp
  obtain ⟨ξ, hξ⟩ := MsetsLower.Probability.exists_fixed_table μ ν hE hpENN
  refine ⟨ξ, ?_⟩
  change p ≤ ENNReal.toReal (ν {r | b ≤ regret (ξ, r)})
  exact (ENNReal.ofReal_le_iff_le_toReal (measure_ne_top _ _)).1 hξ

/-- The same averaging step for a measurable family of experiments. This
version does not incorrectly assume independence of the observed history and
the adversary seed: the history is sampled from the conditional kernel `K`. -/
theorem exists_fixed_adversary_kernel
    {Ξ Ω : Type*} [MeasurableSpace Ξ] [MeasurableSpace Ω]
    (μ : Measure Ξ) [IsProbabilityMeasure μ]
    (K : Kernel Ξ Ω) [IsMarkovKernel K]
    {E : Set Ω} (hE : MeasurableSet E) {p : ℝ}
    (hp : p ≤ (K ∘ₘ μ).real E) :
    ∃ ξ : Ξ, p ≤ (K ξ).real E :=
  MsetsLower.Probability.exists_fixed_kernel_real μ K hE hp

/-- L11 for an explicit complementary size. The witness is a `LossProcess`,
whose fields enforce measurability, non-anticipation, and `[0,1]` action losses.
Both the regret threshold and its probability are preserved exactly. -/
theorem lower_tail_for_complementary_size
    {d m s T : ℕ} (hmd : m ≤ d) (hsd : s ≤ d)
    (hm : 0 < d - s) (hms : m = d - s)
    {threshold probability : ℝ}
    (h : ∀ P : Policy d s,
      HasRegretLowerTail hsd P T threshold probability) :
    ∀ P : Policy d m, HasRegretLowerTail hmd P T threshold probability := by
  subst m
  intro P
  exact ComplementSeed.lower_tail_via_common_seed hsd hm h P

/-- Transport along equality of action sizes, without changing either tail
parameter. This is the identity branch of the complement reduction. -/
theorem lower_tail_for_equal_size
    {d m s T : ℕ} (hmd : m ≤ d) (hsd : s ≤ d) (hms : m = s)
    {threshold probability : ℝ}
    (h : ∀ P : Policy d s,
      HasRegretLowerTail hsd P T threshold probability) :
    ∀ P : Policy d m, HasRegretLowerTail hmd P T threshold probability := by
  subst m
  exact h

/-- L11 with the manuscript's literal choice `s = min m (d-m)`. This includes
`m=d`; positivity of the original action size is the only denominator condition
needed by the complement loss transform. -/
theorem lower_tail_of_min_size
    {d m T : ℕ} (hm : 0 < m) (hmd : m ≤ d)
    {threshold probability : ℝ}
    (h : ∀ P : Policy d (min m (d - m)),
      HasRegretLowerTail ((min_le_left m (d - m)).trans hmd) P T
        threshold probability) :
    ∀ P : Policy d m, HasRegretLowerTail hmd P T threshold probability := by
  by_cases hhalf : m ≤ d - m
  · exact lower_tail_for_equal_size hmd ((min_le_left m (d - m)).trans hmd)
      (min_eq_left hhalf).symm h
  · have hsmall : min m (d - m) = d - m := min_eq_right (le_of_not_ge hhalf)
    have hcomplement : m = d - min m (d - m) := by
      rw [hsmall, Nat.sub_sub_self hmd]
    have hpositive : 0 < d - min m (d - m) := by
      rw [← hcomplement]
      exact hm
    exact lower_tail_for_complementary_size hmd
      ((min_le_left m (d - m)).trans hmd) hpositive hcomplement h

/-- L13: an integrable real random variable with positive mean and an a.s.
upper bound has the stated half-mean tail. Nonnegativity of `X` is not required.
Integrability makes the manuscript's real expectation well-defined. -/
theorem probability_ge_half_mean
    {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (X : Ω → ℝ) (hX : Measurable X) (hXi : Integrable X P)
    {M μ : ℝ} (hμ : 0 < μ) (hmean : μ ≤ ∫ ω, X ω ∂P)
    (hupper : ∀ᵐ ω ∂P, X ω ≤ M) :
    μ / (2 * M) ≤ P.real {ω | μ / 2 ≤ X ω} :=
  MsetsLower.Probability.probability_ge_half_mean_of_ae_le
    P X hX hXi hμ hmean hupper

/-- The sparse construction's elementary conversion: `E Γ ≥ B/4` and
`Γ ≤ B` imply `P(Γ ≥ B/8) ≥ 1/8`, even if `Γ` sometimes is negative. -/
theorem deficit_tail_one_eighth
    {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (Γ : Ω → ℝ) (hΓ : Measurable Γ) (hΓi : Integrable Γ P)
    {B : ℝ} (hB : 0 < B) (hmean : B / 4 ≤ ∫ ω, Γ ω ∂P)
    (hupper : ∀ᵐ ω ∂P, Γ ω ≤ B) :
    (1 : ℝ) / 8 ≤ P.real {ω | B / 8 ≤ Γ ω} := by
  have htail := probability_ge_half_mean P Γ hΓ hΓi (by positivity : 0 < B / 4)
    hmean hupper
  have hratio : (B / 4) / (2 * B) = (1 : ℝ) / 8 := by
    field_simp
    ring
  have hthreshold : B / 4 / 2 = B / 8 := by ring
  simpa only [hratio, hthreshold] using htail

/-- The dense construction uses the weaker upper bound `Γ ≤ 2B`, yielding
`P(Γ ≥ B/8) ≥ 1/16` under the same mean hypothesis. -/
theorem deficit_tail_one_sixteenth
    {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (Γ : Ω → ℝ) (hΓ : Measurable Γ) (hΓi : Integrable Γ P)
    {B : ℝ} (hB : 0 < B) (hmean : B / 4 ≤ ∫ ω, Γ ω ∂P)
    (hupper : ∀ᵐ ω ∂P, Γ ω ≤ 2 * B) :
    (1 : ℝ) / 16 ≤ P.real {ω | B / 8 ≤ Γ ω} := by
  have htail := probability_ge_half_mean P Γ hΓ hΓi (by positivity : 0 < B / 4)
    hmean hupper
  have hratio : (B / 4) / (2 * (2 * B)) = (1 : ℝ) / 16 := by
    field_simp
    ring
  have hthreshold : B / 4 / 2 = B / 8 := by ring
  simpa only [hratio, hthreshold] using htail

/-- An a.s. lower bound by a nonnegative multiple of the deficit transfers
its tail to the actual regret random variable. No integrability or sign
assumption on regret is used in this event-containment step. -/
theorem scaled_regret_tail_of_deficit_tail
    {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (Γ regret : Ω → ℝ) {a b p : ℝ} (ha : 0 ≤ a)
    (hpath : ∀ᵐ ω ∂P, a * Γ ω ≤ regret ω)
    (htail : p ≤ P.real {ω | b ≤ Γ ω}) :
    p ≤ P.real {ω | a * b ≤ regret ω} := by
  apply htail.trans
  have hmono : P {ω | b ≤ Γ ω} ≤ P {ω | a * b ≤ regret ω} := by
    apply measure_mono_ae
    filter_upwards [hpath] with ω hω
    intro hΓ
    exact (mul_le_mul_of_nonneg_left hΓ ha).trans hω
  exact ENNReal.toReal_mono (measure_ne_top _ _) hmono

/-- The combined L13 and scaling step, with constants left symbolic for use
by either lower-bound construction. -/
theorem scaled_regret_tail_of_mean
    {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (Γ regret : Ω → ℝ) (hΓ : Measurable Γ) (hΓi : Integrable Γ P)
    {a M μ : ℝ} (ha : 0 ≤ a) (hμ : 0 < μ)
    (hmean : μ ≤ ∫ ω, Γ ω ∂P) (hupper : ∀ᵐ ω ∂P, Γ ω ≤ M)
    (hpath : ∀ᵐ ω ∂P, a * Γ ω ≤ regret ω) :
    μ / (2 * M) ≤ P.real {ω | a * (μ / 2) ≤ regret ω} :=
  scaled_regret_tail_of_deficit_tail P Γ regret ha hpath
    (probability_ge_half_mean P Γ hΓ hΓi hμ hmean hupper)

/-- A semantic bridge to the manuscript's adversarial model: a deficit bound
under the genuine run law supplies a deterministic loss-process witness for
the corresponding external-regret lower tail. It does not assume the desired
regret-tail conclusion as a premise. -/
theorem has_regret_lower_tail_of_deficit_mean
    {d m T : ℕ} (hmd : m ≤ d)
    (P : Policy d m) (L : LossProcess d m)
    (Γ : History d m T → ℝ) (hΓ : Measurable Γ)
    (hΓi : Integrable Γ (runLaw P L T))
    {a M μ : ℝ} (ha : 0 ≤ a) (hμ : 0 < μ)
    (hmean : μ ≤ ∫ h, Γ h ∂runLaw P L T)
    (hupper : ∀ᵐ h ∂runLaw P L T, Γ h ≤ M)
    (hpath : ∀ᵐ h ∂runLaw P L T, a * Γ h ≤ pathRegret L T h) :
    HasRegretLowerTail hmd P T (a * (μ / 2)) (μ / (2 * M)) := by
  letI : Nonempty (MSetAction d m) := nonempty_MSetAction hmd
  have htail := scaled_regret_tail_of_mean (runLaw P L T) Γ
    (pathRegret L T) hΓ hΓi ha hμ hmean hupper hpath
  refine ⟨L, ?_⟩
  unfold regretTailProbability
  exact (ENNReal.ofReal_le_iff_le_toReal (measure_ne_top _ _)).2 htail

end

end MsetsPaper.Lower
