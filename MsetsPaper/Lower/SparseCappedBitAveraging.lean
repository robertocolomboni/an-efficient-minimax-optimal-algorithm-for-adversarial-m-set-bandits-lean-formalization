import MsetsPaper.Lower.SparseCappedLaw

/-! # Conditioning one coordinate of the actual biased Bernoulli prior -/

namespace MsetsPaper.Lower.SparseCapped

open MeasureTheory ProbabilityTheory Set
open scoped BigOperators ENNReal ProbabilityTheory

noncomputable section

def bitWeight (b : Bool) : ℝ := if b then 1 / 256 else 255 / 256

/-- Splitting off coordinate i does not change the other independent bits. -/
theorem integral_bits_split {n : ℕ} (i : Fin (n + 1)) (f : Bits (n + 1) → ℝ) :
    (∫ U, f U ∂bitsMeasure (n + 1)) =
      ∫ V : Bits n, ∫ b, f (Fin.insertNth i b V) ∂bitMeasure ∂bitsMeasure n := by
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) => Bool) i
  have he : MeasurePreserving e (bitsMeasure (n + 1)) (bitMeasure.prod (bitsMeasure n)) :=
    measurePreserving_piFinSuccAbove (fun _ => bitMeasure) i
  rw [← he.symm.integral_comp' f]
  exact integral_prod_symm _ Integrable.of_finite

/-- This identity is the conditional-probability step; it holds for arbitrary f,
including f that depends on the full adaptive run generated by the bits. -/
theorem integral_bit_condition {d : ℕ} (i : Fin d) (b : Bool) (f : Bits d → ℝ) :
    (∫ U, if U i = b then f U else 0 ∂bitsMeasure d) =
      bitWeight b * ∫ U, f (Function.update U i b) ∂bitsMeasure d := by
  cases d with
  | zero => exact Fin.elim0 i
  | succ n =>
      rw [integral_bits_split i, integral_bits_split i]
      simp only [Fin.insertNth_apply_same, Fin.update_insertNth]
      simp_rw [integral_bitMeasure]
      cases b
      · simp only [Bool.true_eq_false, if_false, ite_true, mul_zero, zero_add,
          bitWeight, Bool.false_eq_true]
        rw [integral_const_mul]
        congr 1
        apply integral_congr_ae
        filter_upwards [] with V
        ring
      · simp only [ite_true, Bool.false_eq_true, if_false, mul_zero, add_zero,
          bitWeight]
        rw [integral_const_mul]
        congr 1
        apply integral_congr_ae
        filter_upwards [] with V
        ring

end

end MsetsPaper.Lower.SparseCapped
