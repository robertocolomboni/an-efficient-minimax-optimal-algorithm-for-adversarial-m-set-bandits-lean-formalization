import MsetsPaper.Probability.AmbientHistoryFactorization

/-! # Finite-horizon predictable factors with almost-sure normalization

Nothing is required after the stated horizon. Null exceptional values are
replaced measurably, and valid factors are then extended to every canonical
history by the preceding Doob--Dynkin construction.
-/

namespace MsetsPaper.Probability.AmbientHistory

open MeasureTheory ProbabilityTheory MsetsLower MsetsPaper.Upper
open scoped BigOperators

noncomputable section

variable {Ω : Type*} [MeasurableSpace Ω] {d m : ℕ}

theorem measurable_history_upto (X : ℕ → Ω → Action d m)
    (ell : ℕ → Ω → Fin d → ℝ) (T : ℕ)
    (hX : ∀ t < T, Measurable (X t))
    (hell : ∀ t < T, Measurable[historySigma X ell t] (ell t)) :
    ∀ t ≤ T, Measurable (history X ell t) := by
  intro t
  induction t with
  | zero => intro ht; exact measurable_const
  | succ t ih =>
      intro ht
      have htm : t ≤ T := by omega
      have htT : t < T := by omega
      have hl : Measurable (ell t) := (hell t htT).mono (ih htm).comap_le le_rfl
      exact (ih htm).prodMk ((hX t htT).prodMk
        ((measurable_actionLoss_joint hl).comp (measurable_id.prodMk (hX t htT))))

/-- The actual finite-horizon filtration, with sigma-algebras exactly equal
to those generated by the recorded interaction histories. -/
def generatedFiltration (X : ℕ → Ω → Action d m)
    (ell : ℕ → Ω → Fin d → ℝ) (T : ℕ)
    (hX : ∀ t < T, Measurable (X t))
    (hell : ∀ t < T, Measurable[historySigma X ell t] (ell t)) :
    Filtration (Fin (T + 1)) (inferInstance : MeasurableSpace Ω) where
  seq t := historySigma X ell t.val
  mono' := by
    intro i j hij
    exact (monotone_nat_of_le_succ (historySigma_mono X ell)) hij
  le' t := (measurable_history_upto X ell T hX hell t.val (by omega)).comap_le

theorem exists_normalized_loss_upto (μ : Measure Ω)
    (H : (t : ℕ) → Ω → History d m t) (ell : ℕ → Ω → Fin d → ℝ) (T : ℕ)
    (hell : ∀ t < T, Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)]
      (ell t))
    (hnorm : ∀ t < T, ∀ᵐ ω ∂μ, ∀ a : Action d m, |actionLoss a (ell t ω)| ≤ 1) :
    ∃ L : SignedLossProcess d m, ∀ t < T, ∀ᵐ ω ∂μ, L.itemLoss t (H t ω) = ell t ω := by
  classical
  let good (t : ℕ) (ω : Ω) := ∀ a : Action d m, |actionLoss a (ell t ω)| ≤ 1
  let safe (t : ℕ) (ω : Ω) : Fin d → ℝ :=
    if t < T then if good t ω then ell t ω else 0 else 0
  have hsafe (t : ℕ) :
      Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)] (safe t) := by
    letI : MeasurableSpace Ω := (inferInstance : MeasurableSpace (History d m t)).comap (H t)
    by_cases ht : t < T
    · have hgood : MeasurableSet[(inferInstance : MeasurableSpace (History d m t)).comap (H t)]
          {ω | good t ω} := by
        simpa only [good, Set.setOf_forall] using MeasurableSet.iInter
          (fun a ↦ measurableSet_le (measurable_actionLoss a (hell t ht)).abs
            (measurable_const (a := (1 : ℝ))))
      simpa only [safe, if_pos ht] using Measurable.ite hgood (hell t ht) measurable_const
    · simpa only [safe, if_neg ht] using
        (measurable_const : Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)]
          (fun _ : Ω ↦ (0 : Fin d → ℝ)))
  have hbound (t : ℕ) (ω : Ω) (a : Action d m) : |actionLoss a (safe t ω)| ≤ 1 := by
    dsimp [safe]
    split_ifs with ht hg
    · exact hg a
    · simp [actionLoss]
    · simp [actionLoss]
  obtain ⟨L, hL⟩ := exists_normalized_loss H safe hsafe hbound
  refine ⟨L, ?_⟩
  intro t ht
  filter_upwards [hnorm t ht] with ω hω
  rw [hL]
  simp only [safe, if_pos ht, show good t ω from hω, if_true]

theorem exists_normalized_policy_upto (μ : Measure Ω) (hmd : m ≤ d)
    (H : (t : ℕ) → Ω → History d m t) (p : ℕ → Ω → Action d m → ℝ) (T : ℕ)
    (hp : ∀ t < T,
      Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)] (p t))
    (hvalid : ∀ t < T, ∀ᵐ ω ∂μ, IsDistribution (p t ω)) :
    ∃ P : Policy d m, ∀ t < T, ∀ᵐ ω ∂μ,
      P.kernel t (H t ω) = finiteAtomicMeasure (p t ω) id := by
  classical
  let a₀ : Action d m := Classical.choice (nonempty_MSetAction hmd)
  let fallback : Action d m → ℝ := fun a ↦ if a = a₀ then 1 else 0
  have hfallback : IsDistribution fallback := by
    constructor
    · intro a; simp only [fallback]; split_ifs <;> norm_num
    · simp [fallback]
  let safe (t : ℕ) (ω : Ω) :=
    if t < T then if IsDistribution (p t ω) then p t ω else fallback else fallback
  have hsafe (t : ℕ) :
      Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)] (safe t) := by
    letI : MeasurableSpace Ω := (inferInstance : MeasurableSpace (History d m t)).comap (H t)
    by_cases ht : t < T
    · have hgood : MeasurableSet[(inferInstance : MeasurableSpace (History d m t)).comap (H t)]
          {ω | IsDistribution (p t ω)} := by
        simpa only [IsDistribution, Set.setOf_and, Set.setOf_forall] using
          (MeasurableSet.iInter (fun a ↦ measurableSet_le (measurable_const (a := (0 : ℝ)))
            ((hp t ht).eval (a := a)))).inter
            (measurableSet_eq_fun
              (Finset.measurable_sum Finset.univ (fun a _ ↦ (hp t ht).eval (a := a)))
              (measurable_const (a := (1 : ℝ))))
      simpa only [safe, if_pos ht] using Measurable.ite hgood (hp t ht) measurable_const
    · simpa only [safe, if_neg ht] using
        (measurable_const : Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)]
          (fun _ : Ω ↦ fallback))
  have hbound (t : ℕ) (ω : Ω) : IsDistribution (safe t ω) := by
    dsimp [safe]
    split_ifs with ht hv
    · exact hv
    · exact hfallback
    · exact hfallback
  obtain ⟨P, hP⟩ := exists_normalized_policy hmd H safe hsafe hbound
  refine ⟨P, ?_⟩
  intro t ht
  filter_upwards [hvalid t ht] with ω hω
  rw [hP]
  simp only [safe, if_pos ht, if_pos hω]

end
end MsetsPaper.Probability.AmbientHistory
