import MsetsPaper.Upper.AdaptiveExecution
import Mathlib.MeasureTheory.Function.FactorsThrough

/-! # Predictability in the sigma-algebra generated by observable history

Doob--Dynkin factorization is applied to the actual history sigma-algebra,
not to an enlarged filtration containing private signals. The factors are
normalized on all histories without changing their values on observed ones.
-/

namespace MsetsPaper.Probability.AmbientHistory

open MeasureTheory ProbabilityTheory MsetsLower MsetsPaper.Upper
open scoped BigOperators

noncomputable section

variable {Ω : Type*} [MeasurableSpace Ω] {d m : ℕ}

def history (X : ℕ → Ω → Action d m) (ell : ℕ → Ω → Fin d → ℝ) :
    (t : ℕ) → Ω → History d m t
  | 0, _ => ()
  | t + 1, ω => (history X ell t ω).snoc (X t ω) (actionLoss (X t ω) (ell t ω))

/-- The paper's filtration at time t, before action t is drawn. -/
def historySigma (X : ℕ → Ω → Action d m) (ell : ℕ → Ω → Fin d → ℝ)
    (t : ℕ) : MeasurableSpace Ω :=
  (inferInstance : MeasurableSpace (History d m t)).comap (history X ell t)

theorem measurable_history (X : ℕ → Ω → Action d m)
    (ell : ℕ → Ω → Fin d → ℝ) (hX : ∀ t, Measurable (X t))
    (hell : ∀ t, Measurable[historySigma X ell t] (ell t)) :
    ∀ t, Measurable (history X ell t) := by
  intro t
  induction t with
  | zero => exact measurable_const
  | succ t ih =>
      have hl : Measurable (ell t) := (hell t).mono ih.comap_le le_rfl
      exact ih.prodMk ((hX t).prodMk
        ((measurable_actionLoss_joint hl).comp (measurable_id.prodMk (hX t))))

theorem historySigma_mono (X : ℕ → Ω → Action d m)
    (ell : ℕ → Ω → Fin d → ℝ) (t : ℕ) :
    historySigma X ell t ≤ historySigma X ell (t + 1) := by
  change (inferInstance : MeasurableSpace (History d m t)).comap (history X ell t) ≤
    (inferInstance : MeasurableSpace (History d m (t + 1))).comap (history X ell (t + 1))
  have he : (fun h : History d m (t + 1) ↦ h.1) ∘ history X ell (t + 1) =
      history X ell t := rfl
  rw [← he, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono measurable_fst.comap_le

/-- Normalization is imposed globally on the factor, not on the image set
of the history map (whose measurability is not assumed). -/
theorem exists_normalized_loss
    (H : (t : ℕ) → Ω → History d m t) (ell : ℕ → Ω → Fin d → ℝ)
    (hell : ∀ t, Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)]
      (ell t))
    (hnorm : ∀ t ω (a : Action d m), |actionLoss a (ell t ω)| ≤ 1) :
    ∃ L : SignedLossProcess d m, ∀ t ω, L.itemLoss t (H t ω) = ell t ω := by
  classical
  choose g hg hfac using (fun t ↦ (hell t).exists_eq_measurable_comp)
  let good (t : ℕ) (h : History d m t) := ∀ a : Action d m, |actionLoss a (g t h)| ≤ 1
  have hgood (t : ℕ) : MeasurableSet {h | good t h} := by
    simpa only [good, Set.setOf_forall] using
      MeasurableSet.iInter (fun a ↦ measurableSet_le
        (measurable_actionLoss a (hg t)).abs (measurable_const (a := (1 : ℝ))))
  let L : SignedLossProcess d m := {
    itemLoss t h := if good t h then g t h else 0
    measurable_itemLoss t := Measurable.ite (hgood t) (hg t) measurable_const
    action_abs_le_one t h a := by
      change |actionLoss a (if good t h then g t h else 0)| ≤ 1
      split_ifs with hh
      · exact hh a
      · simp [actionLoss] }
  refine ⟨L, ?_⟩
  intro t ω
  have he : ell t ω = g t (H t ω) := congrFun (hfac t) ω
  have hv : good t (H t ω) := by
    intro a
    rw [← he]
    exact hnorm t ω a
  change (if good t (H t ω) then g t (H t ω) else 0) = ell t ω
  rw [if_pos hv, ← he]

def IsDistribution (p : Action d m → ℝ) : Prop :=
  (∀ a, 0 ≤ p a) ∧ ∑ a, p a = 1

/-- A predictable probability vector factors into one valid Markov policy.
The default at invalid factor values is a fixed arm distribution; no image
measurability or independence of seed and history is required. -/
theorem exists_normalized_policy (hmd : m ≤ d)
    (H : (t : ℕ) → Ω → History d m t) (p : ℕ → Ω → Action d m → ℝ)
    (hp : ∀ t, Measurable[(inferInstance : MeasurableSpace (History d m t)).comap (H t)] (p t))
    (hvalid : ∀ t ω, IsDistribution (p t ω)) :
    ∃ P : Policy d m, ∀ t ω, P.kernel t (H t ω) = finiteAtomicMeasure (p t ω) id := by
  classical
  choose g hg hfac using (fun t ↦ (hp t).exists_eq_measurable_comp)
  let a₀ : Action d m := Classical.choice (nonempty_MSetAction hmd)
  let fallback : Action d m → ℝ := fun a ↦ if a = a₀ then 1 else 0
  have hfallback : IsDistribution fallback := by
    constructor
    · intro a; simp only [fallback]; split_ifs <;> norm_num
    · simp [fallback]
  have hgood (t : ℕ) : MeasurableSet {h | IsDistribution (g t h)} := by
    simpa only [IsDistribution, Set.setOf_and, Set.setOf_forall] using
      (MeasurableSet.iInter (fun a ↦ measurableSet_le (measurable_const (a := (0 : ℝ)))
      ((hg t).eval (a := a)))).inter
      (measurableSet_eq_fun (Finset.measurable_sum Finset.univ (fun a _ ↦ (hg t).eval (a := a)))
        (measurable_const (a := (1 : ℝ))))
  let q (t : ℕ) (h : History d m t) := if IsDistribution (g t h) then g t h else fallback
  have hq (t : ℕ) (h : History d m t) : IsDistribution (q t h) := by
    dsimp [q]
    split_ifs with hh
    · exact hh
    · exact hfallback
  have hqm (t : ℕ) : Measurable (q t) := Measurable.ite (hgood t) (hg t) measurable_const
  let P : Policy d m := {
    kernel t := {
      toFun h := finiteAtomicMeasure (q t h) id
      measurable' := measurable_finiteAtomicMeasure _ (fun a ↦ (hqm t).eval (a := a)) id }
    isMarkov t := ⟨fun h ↦ finiteAtomicMeasure_isProbabilityMeasure _ (hq t h).1 id (hq t h).2⟩ }
  refine ⟨P, ?_⟩
  intro t ω
  have he : p t ω = g t (H t ω) := congrFun (hfac t) ω
  have hv : IsDistribution (g t (H t ω)) := he ▸ hvalid t ω
  change finiteAtomicMeasure (q t (H t ω)) id = _
  simp only [q, if_pos hv, ← he]

end
end MsetsPaper.Probability.AmbientHistory
