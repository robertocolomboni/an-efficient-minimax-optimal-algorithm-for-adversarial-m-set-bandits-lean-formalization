import MsetsPaper.Alignment.UpperObservable
import MsetsPaper.Probability.AmbientHistoryRegret
import MsetsPaper.Probability.AmbientHistorySampling
import MsetsPaper.Probability.AmbientHistoryMain

/-! # T1 on an arbitrary ambient probability space

The filtration is generated by the recorded actions and scalar feedback.
Losses and the selected action probabilities are predictable in that
filtration. The only sampling assumption is the conditional distribution of
the next action. Equality with the canonical run law is proved below.
-/

namespace MsetsPaper.Alignment

open MeasureTheory ProbabilityTheory MsetsLower MsetsPaper.Upper
open MsetsPaper.Probability MsetsPaper.Probability.AmbientHistory
open scoped ProbabilityTheory

noncomputable section

variable {Ω : Type*} [MeasurableSpace Ω] {d m : ℕ}

/-- T1 with the paper's ambient random variables and actual regret. All
probabilistic assumptions concern the finite horizon only. Normalization,
the algorithmic choice rule, and conditional sampling need hold only a.s. -/
theorem upper_main_regret_ambient
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → Action d m) (ell : ℕ → Ω → Fin d → ℝ)
    (p : ℕ → Ω → Action d m → ℝ)
    (hmpos : 1 ≤ m) (hmtop : m ≤ d - 1) (T : ℕ) (hT : 0 < T)
    {delta : ℝ} (hdelta0 : 0 < delta) (hdelta1 : delta < 1)
    (hX : ∀ t < T, Measurable (X t))
    (hell : ∀ t < T, Measurable[historySigma X ell t] (ell t))
    (hp : ∀ t < T, Measurable[historySigma X ell t] (p t))
    (hnorm : ∀ t < T, ∀ᵐ ω ∂μ, ∀ a : Action d m, |actionLoss a (ell t ω)| ≤ 1)
    (halgorithm : ∀ t < T, ∀ᵐ ω ∂μ,
      p t ω = weightedLaw (m := m)
        (ellipsoidAlgorithmParameters
          (mainLearningRate d T (Nat.choose d m) delta) T t (history X ell t ω)))
    (hsample : letI : Nonempty (Action d m) := nonempty_MSetAction (show m ≤ d by omega)
      ∀ t < T, ∀ᵐ ω ∂μ,
        condDistrib (X t) (history X ell t) μ (history X ell t ω) =
          finiteAtomicMeasure (p t ω) id) :
    1 - delta ≤ μ.real {ω | regret X ell T ω ≤
      160 * Real.sqrt ((d : ℝ) * T *
        (Real.log (Nat.choose d m) + Real.log (1 / delta)))} := by
  have hmd : m ≤ d := by omega
  letI : Nonempty (Action d m) := nonempty_MSetAction hmd
  obtain ⟨L, hL, hmainlaw⟩ := exists_mainAlgorithm_ambient_law μ X ell p hmd T delta
    hX hell hp hnorm halgorithm hsample
  have hH := measurable_history_upto X ell T hX hell
  rw [regret_event_transport μ X ell (mainAlgorithm T delta hmd) L T
    (hH T le_rfl) hL (hmainlaw T le_rfl)]
  exact upper_main_regret L hmpos hmtop T hT hdelta0 hdelta1

/-- The same result stated with the usual conditional probabilities of
individual actions, rather than a regular-conditional-distribution object. -/
theorem upper_main_regret_ambient_of_conditional_expectations
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X : ℕ → Ω → Action d m) (ell : ℕ → Ω → Fin d → ℝ)
    (p : ℕ → Ω → Action d m → ℝ)
    (hmpos : 1 ≤ m) (hmtop : m ≤ d - 1) (T : ℕ) (hT : 0 < T)
    {delta : ℝ} (hdelta0 : 0 < delta) (hdelta1 : delta < 1)
    (hX : ∀ t < T, Measurable (X t))
    (hell : ∀ t < T, Measurable[historySigma X ell t] (ell t))
    (hp : ∀ t < T, Measurable[historySigma X ell t] (p t))
    (hnorm : ∀ t < T, ∀ᵐ ω ∂μ, ∀ a : Action d m, |actionLoss a (ell t ω)| ≤ 1)
    (halgorithm : ∀ t < T, ∀ᵐ ω ∂μ,
      p t ω = weightedLaw (m := m)
        (ellipsoidAlgorithmParameters
          (mainLearningRate d T (Nat.choose d m) delta) T t (history X ell t ω)))
    (hsample : ∀ t < T, ∀ a : Action d m,
      μ⟦(X t) ⁻¹' {a} | historySigma X ell t⟧ =ᵐ[μ] fun ω ↦ p t ω a) :
    1 - delta ≤ μ.real {ω | regret X ell T ω ≤
      160 * Real.sqrt ((d : ℝ) * T *
        (Real.log (Nat.choose d m) + Real.log (1 / delta)))} := by
  have hmd : m ≤ d := by omega
  letI : Nonempty (Action d m) := nonempty_MSetAction hmd
  apply upper_main_regret_ambient μ X ell p hmpos hmtop T hT hdelta0 hdelta1
    hX hell hp hnorm halgorithm
  intro t ht
  have hvalid : ∀ᵐ ω ∂μ, IsDistribution (p t ω) := by
    filter_upwards [halgorithm t ht] with ω hω
    rw [hω]
    exact ⟨fun a ↦ (weightedLaw_pos _ hmd a).le, sum_weightedLaw _ hmd⟩
  exact (conditional_sampling_iff_indicators μ (history X ell t) (X t) (p t)
    (measurable_history_upto X ell T hX hell t (by omega)) (hX t ht) hvalid).2 (hsample t ht)

end
end MsetsPaper.Alignment
